# Пример переменных окружения для bionicpro-auth.
# Префикс AUTH_ обязателен (см. app/config.py).

AUTH_KEYCLOAK_INTERNAL_URL=http://keycloak:8080
AUTH_KEYCLOAK_PUBLIC_URL=http://localhost:8080
AUTH_REALM=reports-realm
AUTH_CLIENT_ID=bionicpro-auth
AUTH_CLIENT_SECRET=bionicpro-auth-secret-change-me

AUTH_REDIRECT_URI=http://localhost:8000/auth/callback
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_API_URL=http://reports-api:8000

AUTH_SESSION_COOKIE_NAME=bionicpro_session
AUTH_SESSION_TTL_SECONDS=1800
# В локальной разработке по http выставите false, в проде — true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Ключ Fernet (base64, 32 байта). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_FERNET_KEY=
